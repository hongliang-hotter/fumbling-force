---
import  BaseLayout  from "../layouts/BaseLayout.astro";

const getUser = () =>{
	return Math.random() < 0.5? null:{
		name:'Tina',
		email:'Tina@bookbites.com'
	}
}
const user = getUser();
---
<BaseLayout>
<div class="content">
	{
		user&&(
		<h3>Welcome ,{user.name}</h3>
	    <p>login messages {user.email}</p>)
	}
	<!-- 该函数当user不为null时，都显示出来h3,p -->
	<p>Lorem ipsum dolor sit amet consectetur.adipisicing elit</p>
    <a href="/books">Take a look at my reviews</a>
</div>
</BaseLayout>
<!-- //下面是样式，只在该页面中有用 -->
<style>
	.content{
		text-align: center;
	}
	a{
		display: inline-block;
		background-color:#7a49c5;
		color:#fff;
		padding:6px 10px;
		border-radius:2px;
		text-decoration: none;
		margin-top: 20px;
	}
	a:hover{
		background-color: #965ee9;
	}
</style>